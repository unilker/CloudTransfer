# ---------------------------------------------------------------------------
# CloudTransfer configuration
# Copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# Public base URL of this instance. Must match the OAuth redirect URIs you
# register with Google and Microsoft. Use https:// for any non-localhost host.
CT_BASE_URL=http://localhost:8080

# --- Google Cloud project -> APIs & Services -> Credentials ----------------
# Create an "OAuth client ID" of type "Web application".
# Authorized redirect URI: <CT_BASE_URL>/auth/google/callback
CT_GOOGLE_CLIENT_ID=
CT_GOOGLE_CLIENT_SECRET=

# --- Microsoft Entra ID (portal.azure.com -> App registrations) ------------
# Redirect URI (type "Web"): <CT_BASE_URL>/auth/microsoft/callback
# Delegated permissions: Files.ReadWrite, offline_access, User.Read
# CT_MS_TENANT: "common" for both personal + work accounts,
#               "consumers" for personal only, or your tenant GUID.
CT_MS_CLIENT_ID=
CT_MS_CLIENT_SECRET=
CT_MS_TENANT=common

# --- Secrets at rest -------------------------------------------------------
# Encrypts stored OAuth refresh tokens and signs session cookies.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left empty a key is generated into <CT_DATA_DIR>/secret.key.
CT_SECRET_KEY=

# --- Storage ---------------------------------------------------------------
CT_DATA_DIR=./data

# --- Transfer tuning -------------------------------------------------------
# RAM buffer per file. MUST be a multiple of 327680 (320 KiB) for OneDrive.
# 10 MiB is a good default; raise for fat pipes, lower for small containers.
# Peak memory is roughly CT_CHUNK_SIZE * CT_MAX_PARALLEL_FILES * 2.
CT_CHUNK_SIZE=10485760

# Files at or below this size go up in a single request instead of an upload
# session. Microsoft's guidance is to switch to a session above 4 MiB, which is
# both the default and the maximum.
CT_SIMPLE_UPLOAD_MAX=4194304

# How many files move at the same time.
CT_MAX_PARALLEL_FILES=3

# Retries per chunk before a file is marked failed.
CT_MAX_RETRIES=6

# Verify each transferred file by comparing hashes end to end.
CT_VERIFY_HASHES=true

# Download files Google has flagged as abusive (you accept the risk).
CT_ACKNOWLEDGE_ABUSE=false

# --- Server ----------------------------------------------------------------
CT_HOST=0.0.0.0
CT_PORT=8080
CT_LOG_LEVEL=INFO
